# ---------------------------------------------------------------------------
# OmniMeetX — backend environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- App ---
# Set ENVIRONMENT=production on the live server
ENVIRONMENT=development
# Used in password-reset email links
FRONTEND_URL=http://localhost:3000
# Public URL of this API, e.g. https://api.yourdomain.com (used for avatar links)
BACKEND_PUBLIC_URL=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET_KEY=change-me-to-a-long-random-string

# --- Database (SQLite locally; Supabase Postgres in production) ---
# Production: Supabase > Connect > "Session pooler" URI (password: letters and digits only).
SQLALCHEMY_DATABASE_URI=sqlite:///data/app.db
# SQLALCHEMY_DATABASE_URI=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Used only by scripts/migrate_to_supabase.py and scripts/upload_files_to_supabase.py
SUPABASE_DB_URL=

# --- Supabase Storage: recordings (private bucket) and profile pictures (public bucket) ---
# Leave empty locally to keep files on disk. Required in production: the server disk is wiped on redeploy.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=recordings

# --- Google sign-in (Clerk dashboard -> API keys -> Secret key) ---
CLERK_SECRET_KEY=

# --- AI: LLM provider chain (tried in order; missing keys are skipped) ---
# Models chosen by benchmark; quotas are per model, so fallbacks keep AI up when one is rate-limited
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_AUDIO_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# Groq also powers Urdu transcription (Whisper)
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
# Sent as the OpenRouter referer header
APP_PUBLIC_URL=

# --- AI: speech-to-text ---
ASSEMBLYAI_API_KEY=

# --- Video calling (https://cloud.livekit.io) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Email (Resend: https://resend.com — free 3,000 emails/month) ---
RESEND_API_KEY=
# Must use a domain you verified in Resend. The default test sender
# onboarding@resend.dev only delivers to your own Resend account email.
EMAIL_FROM="OmniMeetX <onboarding@resend.dev>"
# Inbox that receives contact-form messages
CONTACT_EMAIL=you@yourdomain.com

# --- Payments (Paddle) ---
# PADDLE_SANDBOX must be false in production, and PADDLE_WEBHOOK_SECRET must be set.
# API key: Developer tools > Authentication > API keys (pdl_sdbx_apikey_... / pdl_live_apikey_...)
# Webhook secret: Developer tools > Notifications > your destination > secret key (pdl_ntfset_...)
# Price IDs: Catalog > Products > your product > Prices (pri_...)
PADDLE_SANDBOX=true
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRO_MONTHLY_PRICE_ID=
PADDLE_PRO_YEARLY_PRICE_ID=
PADDLE_PREMIUM_MONTHLY_PRICE_ID=
PADDLE_PREMIUM_YEARLY_PRICE_ID=

# --- Admins: comma-separated emails that can see the user directory, all feedback,
# and set feature-request statuses ---
ADMIN_EMAILS=

# --- Storage & processing ---
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=outputs
RECORDINGS_FOLDER=recordings
MAX_FILE_SIZE_MB=200
MEDIA_RETENTION_DAYS=30
PROCESSING_WORKERS=4

# --- Observability ---
SENTRY_DSN=
